@model IEnumerable<JirHub.Entities.NguyenLPK.Models.WorkLinksNguyenLpk>
@{
    ViewData["Title"] = "Ma trận Truy vết (Traceability Matrix)";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2><i class="fa fa-link text-primary"></i> Ma trận Truy vết</h2>
            <p class="text-muted">
                Liên kết giữa <strong>Jira Requirements</strong> và <strong>Source Code</strong> (FN-11 & 4.3).
                <br />
                <small>Dữ liệu được tự động quét qua Regex: <code>([A-Z]+-\d+)</code> từ Commit Message và PR Title.</small>
            </p>
        </div>
        <a href="/SourceCode/Index?groupId=@ViewBag.GroupId" class="btn btn-secondary">
            <i class="fa fa-arrow-left"></i> Quay lại Dashboard
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center">
            <h4>Chưa có dữ liệu liên kết!</h4>
            <p>Hệ thống chưa tìm thấy mã Jira nào (ví dụ: <code>PRJ-123</code>) trong Commit Message hoặc PR Title.</p>
            <p>Hãy thử tạo Commit mới với message: <em>"Fix login bug PRJ-10"</em> và bấm Đồng bộ lại.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover table-striped mb-0">
                    <thead class="thead-dark">
                        <tr>
                            <th style="width: 15%">Jira Task (Key)</th>
                            <th style="width: 10%">Loại</th>
                            <th style="width: 40%">Định danh GitHub (ID/Hash)</th>
                            <th style="width: 20%">Thời gian phát hiện</th>
                            <th style="width: 15%">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="font-weight-bold text-primary">
                                        <i class="fab fa-jira"></i> @item.JiraIssueKey
                                    </span>
                                </td>

                                <td>
                                    @if (item.GithubEntityType == "COMMIT")
                                    {
                                        <span class="badge badge-secondary">
                                            <i class="fa fa-code-branch"></i> COMMIT
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-success">
                                            <i class="fa fa-code-pull-request"></i> PULL REQ
                                        </span>
                                    }
                                </td>

                                <td>
                                    <code>@item.GithubEntityId</code>
                                    @if (item.GithubEntityType == "COMMIT")
                                    {
                                        <small class="text-muted d-block">(Commit Hash SHA)</small>
                                    }
                                    else
                                    {
                                        <small class="text-muted d-block">(PR Number)</small>
                                    }
                                </td>

                                <td>
                                    @item.LinkedAt != null ? item.LinkedAt.ToString("dd/MM/yyyy HH:mm:ss") : "Null"
                                </td>

                                <td>
                                    <span class="text-success">
                                        <i class="fa fa-check-circle"></i> Đã liên kết
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>