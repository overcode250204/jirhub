@model IEnumerable<JirHub.Entities.NguyenLPK.Models.ProjectReposNguyenLpk>

<div class="container mt-4">
    <h2>Quản lý Mã nguồn (FN-10 & FN-11)</h2>
    
    <div class="row mb-3">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Thêm Repo Mới</div>
                <div class="card-body">
                    <form asp-action="AddRepo" method="post">
                        <input type="hidden" name="groupId" value="@ViewBag.GroupId" />
                        <div class="form-group">
                            <input name="repoUrl" class="form-control" placeholder="URL (e.g., https://github.com/user/repo)" required />
                        </div>
                        <div class="form-group mt-2">
                            <select name="repoType" class="form-control">
                                <option value="BACKEND">Backend</option>
                                <option value="FRONTEND">Frontend</option>
                                <option value="MOBILE">Mobile</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-success mt-2">Thêm</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-6">
             <div class="card">
                <div class="card-header">Thao tác</div>
                <div class="card-body">
                    <form asp-action="Sync" method="post">
                        <input type="hidden" name="groupId" value="@ViewBag.GroupId" />
                        <button type="submit" class="btn btn-primary w-100 mb-2">
                            Đồng bộ Dữ liệu GitHub
                        </button>
                    </form>
                    <a href="/SourceCode/Traceability?groupId=@ViewBag.GroupId" class="btn btn-info w-100">
                        Xem Liên kết Jira - GitHub (4.3)
                    </a>
                </div>
            </div>
        </div>
    </div>

    <table class="table table-bordered mt-3">
        <thead>
            <tr>
                <th>Tên Repo</th>
                <th>URL</th>
                <th>Loại</th>
                <th>Trạng thái</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.RepoName</td>
                    <td>@item.RepoUrl</td>
                    <td>@item.RepoType</td>
                    <td>@(item.IsActive != null ? "Active" : "Inactive")</td>
                </tr>
            }
        </tbody>
    </table>
</div>