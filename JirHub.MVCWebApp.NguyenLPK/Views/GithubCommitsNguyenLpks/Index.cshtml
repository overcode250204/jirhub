@model IEnumerable<JirHub.Entities.NguyenLPK.Models.GithubCommitsNguyenLpk>

@{
    ViewData["Title"] = "Lịch sử Commit";
    var totalLoc = Model.Any() ? Model.Sum(c => (c.Additions ?? 0) + (c.Deletions ?? 0)) : 0;
    var totalAdd = Model.Any() ? Model.Sum(c => c.Additions ?? 0) : 0;
    var totalDel = Model.Any() ? Model.Sum(c => c.Deletions ?? 0) : 0;
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="fa fa-code-commit me-2"></i>Lịch sử Commit</h2>
        <p>
            @if (ViewData["RepoName"] != null)
            {
                <span><i class="fab fa-github me-1"></i>@ViewData["RepoName"]</span>
            }
        </p>
    </div>
    <a asp-controller="ProjectReposNguyenLpks" asp-action="Index" class="btn btn-light">
        <i class="fa fa-arrow-left me-1"></i> Quay lại DS Repo
    </a>
</div>

@if (Model.Any())
{
    <!-- Stat cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body py-3">
                    <div class="fs-3 fw-bold text-primary">@Model.Count()</div>
                    <div class="text-muted small"><i class="fa fa-code-commit me-1"></i>Tổng Commits</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body py-3">
                    <div class="fs-3 fw-bold text-success">+@totalAdd</div>
                    <div class="text-muted small"><i class="fa fa-plus me-1"></i>Dòng thêm</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body py-3">
                    <div class="fs-3 fw-bold text-danger">-@totalDel</div>
                    <div class="text-muted small"><i class="fa fa-minus me-1"></i>Dòng xóa</div>
                </div>
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="card-body p-0">
        <table id="commitsTable" class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th style="width:9%">Hash</th>
                    <th>Commit Message</th>
                    <th style="width:12%">LOC (+/-)</th>
                    <th style="width:15%">Tác giả</th>
                    <th style="width:14%">Jira Task</th>
                    <th style="width:11%">Ngày Commit</th>
                    <th style="width:5%"></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fa fa-inbox fa-3x mb-3 d-block text-secondary"></i>
                            <strong>Chưa có commit nào.</strong><br/>
                            <small>Bấm <kbd>Sync</kbd> trên trang Repo để đồng bộ dữ liệu từ GitHub.</small>
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <code class="bg-light px-2 py-1 rounded border text-dark" style="font-size:.8rem">
                                @(item.CommitHash.Length > 7 ? item.CommitHash[..7] : item.CommitHash)
                            </code>
                        </td>
                        <td>
                            <span class="d-inline-block text-truncate" style="max-width:320px" title="@item.Message">
                                @item.Message
                            </span>
                        </td>
                        <td class="fw-semibold">
                            <span class="text-success" title="Thêm">+@(item.Additions ?? 0)</span>
                            <span class="text-muted mx-1">/</span>
                            <span class="text-danger" title="Xóa">-@(item.Deletions ?? 0)</span>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                                     style="width:28px;height:28px;font-size:.7rem;flex-shrink:0">
                                    @(item.AuthorGithubUsername?.Length > 0 ? item.AuthorGithubUsername[0].ToString().ToUpper() : "?")
                                </div>
                                <small class="text-truncate" style="max-width:90px">@item.AuthorGithubUsername</small>
                            </div>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.LinkedIssueKey))
                            {
                                <span class="badge text-white" style="background:#0052CC;font-size:.8rem">
                                    <i class="fab fa-jira me-1"></i>@item.LinkedIssueKey
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small fst-italic">—</span>
                            }
                        </td>
                        <td>
                            @if (item.CommittedDate.HasValue)
                            {
                                <div class="lh-1">
                                    <div class="fw-semibold" style="font-size:.85rem">@item.CommittedDate.Value.ToString("dd/MM/yyyy")</div>
                                    <small class="text-muted">@item.CommittedDate.Value.ToString("HH:mm")</small>
                                </div>
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.CommitId"
                               class="btn btn-sm btn-outline-primary" title="Xem chi tiết">
                                <i class="fa fa-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>