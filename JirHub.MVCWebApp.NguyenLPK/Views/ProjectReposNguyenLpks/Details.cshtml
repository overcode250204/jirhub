@model JirHub.Entities.NguyenLPK.Models.ProjectReposNguyenLpk

@{
    ViewData["Title"] = "Chi tiết Repository";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="fab fa-github me-2"></i>@Model.RepoName</h2>
        <p>Chi tiết thông tin repository</p>
    </div>
    <a asp-action="Index" class="btn btn-light">
        <i class="fa fa-arrow-left me-1"></i> Quay lại
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header bg-primary text-white">
                <i class="fa fa-circle-info me-2"></i>Thông tin cơ bản
            </div>
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tr>
                        <td class="text-muted fw-semibold" style="width:40%"><i class="fa fa-hashtag me-1"></i>Repo ID</td>
                        <td><strong>@Model.RepoId</strong></td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold"><i class="fa fa-users me-1"></i>Nhóm</td>
                        <td><strong>@(Model.Group?.GroupName ?? $"#{Model.GroupId}")</strong></td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold"><i class="fa fa-code-branch me-1"></i>Tên Repo</td>
                        <td><strong>@Model.RepoName</strong></td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold"><i class="fa fa-layer-group me-1"></i>Loại</td>
                        <td>
                            <span class="badge bg-info text-dark">@Model.RepoType</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold"><i class="fa fa-link me-1"></i>URL</td>
                        <td><a href="@Model.RepoUrl" target="_blank" class="text-primary">Mở GitHub <i class="fa fa-external-link fa-xs"></i></a></td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold"><i class="fa fa-circle me-1"></i>Trạng thái</td>
                        <td>
                            @if (Model.IsActive == true)
                            {
                                <span class="badge bg-success"><i class="fa fa-check me-1"></i>Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                    </tr>
                </table>
            </div>
            <div class="card-footer bg-transparent d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.RepoId" class="btn btn-warning btn-sm">
                    <i class="fa fa-pen me-1"></i>Sửa
                </a>
                <a asp-controller="GithubCommitsNguyenLpks" asp-action="Index" asp-route-repoId="@Model.RepoId" class="btn btn-outline-secondary btn-sm">
                    <i class="fa fa-code-commit me-1"></i>Commits
                </a>
                <a asp-controller="GithubPullRequestsNguyenLpks" asp-action="Index" asp-route-repoId="@Model.RepoId" class="btn btn-outline-secondary btn-sm">
                    <i class="fa fa-code-pull-request me-1"></i>PRs
                </a>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header bg-dark text-white">
                <i class="fa fa-code-pull-request me-2"></i>Pull Requests gần đây
            </div>
            <div class="card-body p-0">
                @if (Model.GithubPullRequestsNguyenLpks != null && Model.GithubPullRequestsNguyenLpks.Any())
                {
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>PR#</th>
                                <th>Tiêu đề</th>
                                <th>Trạng thái</th>
                                <th>Tác giả</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pr in Model.GithubPullRequestsNguyenLpks.Take(5))
                            {
                                <tr>
                                    <td><span class="badge bg-secondary">#@pr.PrNumber</span></td>
                                    <td class="text-truncate" style="max-width:200px">@pr.Title</td>
                                    <td>
                                        @if (pr.IsMerged == true)
                                        {
                                            <span class="badge bg-purple" style="background:#6f42c1">Merged</span>
                                        }
                                        else if (pr.State == "open")
                                        {
                                            <span class="badge bg-success">Open</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Closed</span>
                                        }
                                    </td>
                                    <td><small class="text-muted">@pr.AuthorGithubUsername</small></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center text-muted py-5">
                        <i class="fa fa-inbox fa-3x mb-2 d-block"></i>
                        Chưa có Pull Requests. Bấm <strong>Sync</strong> để đồng bộ.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
