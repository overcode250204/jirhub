@model JirHub.Entities.NguyenLPK.Models.ProjectReposNguyenLpk

@{
    ViewData["Title"] = "Thêm Repo Mới";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="fab fa-github me-2"></i>Thêm Repository Mới</h2>
        <p>Kết nối GitHub repository vào nhóm dự án (FN-10)</p>
    </div>
    <a asp-action="Index" class="btn btn-light">
        <i class="fa fa-arrow-left me-1"></i> Quay lại
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <i class="fa fa-plus-circle me-2"></i>Thông tin Repository
            </div>
            <div class="card-body p-4">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" style="display:none;"></div>

                    <div class="mb-3">
                        <label asp-for="GroupId" class="form-label fw-semibold">
                            <i class="fa fa-users text-primary me-1"></i>Nhóm
                        </label>
                        <select asp-for="GroupId" class="form-select" asp-items="ViewBag.GroupId">
                            <option value="">-- Chọn nhóm --</option>
                        </select>
                        <span asp-validation-for="GroupId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RepoName" class="form-label fw-semibold">
                            <i class="fa fa-code-branch text-primary me-1"></i>Tên Repository
                        </label>
                        <input asp-for="RepoName" class="form-control" placeholder="vd: BloodDonation_BE" />
                        <span asp-validation-for="RepoName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RepoUrl" class="form-label fw-semibold">
                            <i class="fa fa-link text-primary me-1"></i>URL GitHub
                        </label>
                        <input asp-for="RepoUrl" class="form-control" placeholder="https://github.com/owner/repo-name" />
                        <span asp-validation-for="RepoUrl" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RepoType" class="form-label fw-semibold">
                            <i class="fa fa-layer-group text-primary me-1"></i>Loại Repository
                        </label>
                        <select asp-for="RepoType" class="form-select">
                            <option value="">-- Chọn loại --</option>
                            <option value="BACKEND">Backend</option>
                            <option value="FRONTEND">Frontend</option>
                            <option value="MOBILE">Mobile</option>
                            <option value="FULLSTACK">Fullstack</option>
                        </select>
                        <span asp-validation-for="RepoType" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                            <label asp-for="IsActive" class="form-check-label fw-semibold">Kích hoạt (Sync dữ liệu)</label>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary flex-grow-1">
                            <i class="fa fa-plus me-1"></i> Thêm Repository
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
