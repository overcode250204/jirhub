@model JirHub.Entities.NguyenLPK.Models.ProjectReposNguyenLpk

@{
    ViewData["Title"] = "Xác nhận Xóa Repository";
}

<div class="page-header" style="background: linear-gradient(135deg, #7f1d1d, #dc2626);">
    <h2><i class="fa fa-trash me-2"></i>Xác nhận Xóa Repository</h2>
    <p>Hành động này không thể hoàn tác</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <i class="fa fa-triangle-exclamation me-2"></i>Cảnh báo — Xóa vĩnh viễn
            </div>
            <div class="card-body">
                <div class="alert alert-danger d-flex align-items-center gap-3 mb-4">
                    <i class="fa fa-circle-exclamation fa-2x"></i>
                    <div>
                        <strong>Xóa repository sẽ kéo theo toàn bộ:</strong><br/>
                        Tất cả Commits, Pull Requests và Reviews thuộc repository này cũng sẽ bị xóa.
                    </div>
                </div>

                <table class="table table-borderless mb-0">
                    <tr>
                        <td class="text-muted fw-semibold" style="width:40%">Tên Repository</td>
                        <td><strong>@Model.RepoName</strong></td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">Loại</td>
                        <td><span class="badge bg-info text-dark">@Model.RepoType</span></td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">Nhóm</td>
                        <td>@(Model.Group?.GroupName ?? $"#{Model.GroupId}")</td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">URL</td>
                        <td><a href="@Model.RepoUrl" target="_blank">@Model.RepoUrl</a></td>
                    </tr>
                </table>
            </div>
            <div class="card-footer d-flex gap-2 justify-content-end">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fa fa-arrow-left me-1"></i> Hủy, quay lại
                </a>
                <form asp-action="Delete" method="post" style="display:inline;">
                    <input type="hidden" name="id" value="@Model.RepoId" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fa fa-trash me-1"></i> Xác nhận Xóa
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
